# La cuenta propietaria se usa exclusivamente para migraciones.
DATABASE_URL=postgresql://roomplannr_admin:roomplannr_admin_dev@127.0.0.1:5432/roomplannr
# La API usa un rol sin privilegios administrativos ni BYPASSRLS.
APP_DATABASE_URL=postgresql://roomplannr_app:roomplannr_app_dev@127.0.0.1:5432/roomplannr
DATABASE_APP_ROLE=roomplannr_app
# 32 bytes en base64. Generar otro secreto para cada entorno y guardarlo en un secret manager.
# Ejemplo: openssl rand -base64 32
DATA_ENCRYPTION_KEY=<generar-con-openssl-rand-base64-32>
# Para rotación sin perder lectura de datos anteriores:
# DATA_ENCRYPTION_KEYS=1:<clave-anterior-base64>,2:<clave-actual-base64>
# DATA_ENCRYPTION_KEY_VERSION=2
FRONTEND_ORIGIN=http://127.0.0.1:5173
# Para habilitar varios orígenes, usar una lista separada por comas:
# FRONTEND_ORIGINS=http://127.0.0.1:5173,http://127.0.0.1:4173
PORT=3001
HOST=127.0.0.1
NODE_ENV=development

# En producción, preferir frontend y API bajo el mismo dominio.
# Si se usan dominios distintos, configurar también COOKIE_SAME_SITE=none.
# VITE_API_BASE_URL=https://api.example.com
